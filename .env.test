# COMMITTED ON PURPOSE — no secrets in this file. See README "Env".
#
# The suite drives the real Prisma client (`src/lib/auth.test.ts` creates and
# deletes users and sessions), so it must never run against the hosted ledger.
# Bun loads `.env.test` when NODE_ENV=test — above `.env`, and unlike
# `.env.local` it *is* loaded in test mode, so this guard travels with the repo.
# Per-machine override: `.env.test.local`.
DATABASE_URL="file:./ledger.db"
