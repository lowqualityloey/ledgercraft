# Copy to .env (local only, never commit — .env* is gitignored)
DATABASE_URL="file:./ledger.db"

# Hosted (Vercel) — remote libSQL (Turso) so writes survive serverless cold starts.
# `file:/tmp/...` is per-instance and ephemeral: do not use it for real data.
# Remote URLs require a token; a remote URL without one fails closed at startup.
# Either URL name works — TURSO_DATABASE_URL is Turso's own SDK spelling:
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso-auth-token>"   # TURSO_AUTH_TOKEN also accepted
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<turso-auth-token>"

# Auth (M5): change in production, keep local dev placeholder
AUTH_SECRET="change-me-in-prod-32-chars-min"
# Stripe (M7, hosted): test keys, never commit real secrets — set in Vercel env
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
